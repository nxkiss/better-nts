{
  "manifest_version": 3,
  "name": "Better NTS",
  "version": "2.3.0",
  "description": "A better episode player for NTS: full clickable tracklist, save any track, track skipping, volume, media keys, shortcuts, Ctrl+click to open in a new tab and an optional redesign.",
  "homepage_url": "https://github.com/nxkiss/better-nts",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Better NTS: player style",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.nts.live/*", "https://nts.live/*"],
      "js": ["src/content/settings-bridge.js", "src/content/new-tab.js"],
      "css": ["src/content/player.css", "src/content/redesign.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nts.live/*", "https://nts.live/*"],
      "js": ["src/content/player.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "better-nts@nxkiss",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
