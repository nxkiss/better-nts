{
  "manifest_version": 3,
  "name": "NTS Tracklist Seek",
  "version": "2.1.0",
  "description": "Full, clickable tracklist in the NTS episode player, plus save track, track skipping, speed, media keys, shortcuts and an optional redesign.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "NTS Tracklist Seek: player style",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.nts.live/*", "https://nts.live/*"],
      "js": ["bridge.js"],
      "css": ["content.css", "redesign.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nts.live/*", "https://nts.live/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "nts-tracklist-seek@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
